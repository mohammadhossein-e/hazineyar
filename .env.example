DATABASE_URL="postgresql://user:password@localhost:5432/dbname"
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
# Public bot handle, without the leading @. Powers the dashboard's deep link
# and QR onboarding card; leave empty to hide that card.
TELEGRAM_BOT_USERNAME=""
# Bale speaks the Telegram Bot API over its own host.
BALE_BOT_TOKEN="your_bale_bot_token_here"
BALE_BOT_USERNAME=""
# Optional; defaults to https://tapi.bale.ai
BALE_API_BASE="https://tapi.bale.ai"
# Shown as the product name on the dashboard.
PUBLIC_APP_NAME="خزینه‌یار"
UPLOAD_DIR="./uploads"
ADMIN_PASSWORD="your_secure_password_here"
TEST_DATABASE_URL="postgresql://user:password@localhost:5432/dbname_test"
