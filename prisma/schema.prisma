generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  EMPLOYEE
}

enum ExpenseCategory {
  MATERIALS
  WORKER_FOOD
  TRANSPORT
  WAGES
  TOOLS
  OTHER
}

model User {
  id         String       @id @default(cuid())
  name       String
  channel    String
  externalId String
  role       Role         @default(EMPLOYEE)
  isActive   Boolean      @default(true)
  createdAt  DateTime     @default(now())

  userProjects UserProject[]
  expenses     Expense[]     @relation("ExpenseToUser")

  @@unique([channel, externalId])
  @@index([channel, externalId])
  @@index([role])
}

model Project {
  id        String       @id @default(cuid())
  name      String
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())

  expenses    Expense[]     @relation("ExpenseToProject")
  userProjects UserProject[]

  @@index([isActive])
}

model UserProject {
  id        String   @id @default(cuid())
  userId    String
  projectId String

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([userId])
  @@index([projectId])
}

model Expense {
  id              String           @id @default(cuid())
  projectId       String
  userId          String
  category        ExpenseCategory
  amount          BigInt
  description     String?
  invoiceFilePath String?
  invoiceNumber   String           @default("invoice_000")
  expenseDate     DateTime
  createdAt       DateTime         @default(now())
  deletedAt       DateTime?

  project Project @relation("ExpenseToProject", fields: [projectId], references: [id])
  user    User    @relation("ExpenseToUser", fields: [userId], references: [id])

  @@index([projectId])
  @@index([userId])
  @@index([category])
  @@index([expenseDate])
  @@index([deletedAt])
  @@unique([projectId, invoiceNumber])
}